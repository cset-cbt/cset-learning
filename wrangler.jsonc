{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cset-learning",
  "account_id": "02d148fcdf14cd3c072791fd186298be",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cset-learning-db",
      "database_id": "c667df48-bc38-4cef-8c4e-67d1b546cf65",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "cset-learning-files"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "LEARNING_BASE_URL": "https://beta-learning.cset.info.vn"
  },
  "routes": [
    {
      "pattern": "beta-learning.cset.info.vn",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true }
}
