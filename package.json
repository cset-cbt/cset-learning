{
  "name": "@cset/cset-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "node scripts/prepare-runtimes.ts",
    "prebuild": "node scripts/prepare-runtimes.ts",
    "dev": "vite dev --host localhost --port 4177",
    "build": "LEARNING_BUILD=1 vite build",
    "preview": "bun run build && wrangler dev --port 4177",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cset-learning-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cset-learning-db --remote",
    "db:seed:local": "wrangler d1 execute cset-learning-db --local --file scripts/seed-local.sql",
    "db:seed:generate": "bun scripts/generate-seed.ts",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "bootstrap:admin": "bun scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.28",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@mdit/plugin-katex": "1.1.4",
    "@sveltejs/kit": "2.70.2",
    "@tracecode/tracejvm": "0.4.1",
    "better-auth": "1.6.28",
    "codemirror": "6.0.2",
    "cset-ui": "github:cset-cbt/cset-ui#main",
    "dompurify": "3.4.17",
    "drizzle-orm": "0.45.2",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "svelte": "5.56.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@live-codes/clang-wasm": "0.3.0",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.23.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "pyodide": "314.0.7",
    "svelte-check": "4.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
